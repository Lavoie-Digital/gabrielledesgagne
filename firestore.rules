rules_version = '2';

// Le site lit et écrit Firestore uniquement depuis son serveur, avec la clé
// de service (SDK Admin), qui ne passe pas par ces règles. Aucun navigateur
// n'a donc besoin d'un accès direct : tout est fermé.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
