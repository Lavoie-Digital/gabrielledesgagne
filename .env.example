# =====================================================================
#  Pour Clément : variables d'environnement
#  Copiez ce fichier en « .env » et remplissez les valeurs.
#  Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).
# =====================================================================

# --- Firebase, côté navigateur (sert à la connexion de l'espace privé) ---
# Ces valeurs sont publiques par nature : elles se trouvent dans la console
# Firebase > Paramètres du projet > Vos applications.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin, côté serveur : SECRET, ne jamais partager ---
# Tiré du fichier JSON de la clé de service (Console Firebase >
# Paramètres du projet > Comptes de service > Générer une clé privée).
#   project_id   → FIREBASE_PROJECT_ID
#   client_email → FIREBASE_CLIENT_EMAIL
#   private_key  → FIREBASE_PRIVATE_KEY, entre guillemets, sur une seule
#                  ligne, avec les \n tels quels
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# --- Les personnes qui ont accès à l'espace privé (/admin) ---
# Adresses séparées par des virgules.
ADMIN_COURRIELS=xavier@lavoiedigital.ca,gabrielle@lavoiedigital.ca
